{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cashmclean.ca/tagalog/lesson-package.schema.json",
  "title": "Tagalog lesson package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lesson", "sources", "vocabulary", "sentences", "grammar"],
  "properties": {
    "schema_version": { "const": 2 },
    "lesson": { "$ref": "#/$defs/lesson" },
    "sources": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/source" } },
    "default_source_id": { "$ref": "#/$defs/uuid" },
    "vocabulary": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/vocabulary" } },
    "sentences": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/sentence" } },
    "grammar": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/grammar" } }
  },
  "anyOf": [
    { "properties": { "vocabulary": { "minItems": 1 } } },
    { "properties": { "sentences": { "minItems": 1 } } },
    { "properties": { "grammar": { "minItems": 1 } } }
  ],
  "$defs": {
    "uuid": { "type": "string", "maxLength": 1048576, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "nonBlank": { "type": "string", "minLength": 1, "maxLength": 1048576, "pattern": "\\S" },
    "difficulty": { "type": "string", "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED"] },
    "lesson": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": { "id": { "$ref": "#/$defs/uuid" }, "name": { "$ref": "#/$defs/nonBlank" }, "description": { "$ref": "#/$defs/nonBlank" } }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "name": { "$ref": "#/$defs/nonBlank" },
        "type": { "type": "string", "enum": ["TEACHER", "COURSE", "BOOK", "SONG", "VIDEO", "WEBSITE", "OTHER"] },
        "reference": { "$ref": "#/$defs/nonBlank" }
      }
    },
    "vocabulary": {
      "type": "object", "additionalProperties": false, "required": ["id", "tagalog", "english", "part_of_speech", "tags"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "tagalog": { "$ref": "#/$defs/nonBlank" }, "english": { "$ref": "#/$defs/nonBlank" },
        "root_word": { "$ref": "#/$defs/nonBlank" },
        "part_of_speech": { "type": "string", "enum": ["NOUN", "PRONOUN", "VERB", "ADJECTIVE", "ADVERB", "PREPOSITION", "CONJUNCTION", "PARTICLE", "INTERJECTION", "PHRASE", "OTHER"] },
        "difficulty": { "$ref": "#/$defs/difficulty" }, "frequency_rank": { "type": "integer", "minimum": 1 },
        "source_id": { "$ref": "#/$defs/uuid" },
        "tags": { "type": "array", "uniqueItems": true, "maxItems": 100000, "items": { "$ref": "#/$defs/nonBlank" } }
      }
    },
    "sentence": {
      "type": "object", "additionalProperties": false, "required": ["id", "text", "translation", "vocabulary_ids", "grammar_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "text": { "$ref": "#/$defs/nonBlank" }, "translation": { "$ref": "#/$defs/nonBlank" },
        "difficulty": { "$ref": "#/$defs/difficulty" }, "source_id": { "$ref": "#/$defs/uuid" },
        "vocabulary_ids": { "type": "array", "uniqueItems": true, "maxItems": 100000, "items": { "$ref": "#/$defs/uuid" } },
        "grammar_ids": { "type": "array", "uniqueItems": true, "maxItems": 100000, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "grammar": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "description", "formula"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "name": { "$ref": "#/$defs/nonBlank" }, "description": { "$ref": "#/$defs/nonBlank" },
        "formula": { "$ref": "#/$defs/nonBlank" }, "source_id": { "$ref": "#/$defs/uuid" }
      }
    }
  }
}
